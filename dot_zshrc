# Local Path
# ----------
export PATH="$HOME/.local/bin:$PATH"


# Antidote
# --------

export ANTIDOTE_HOME="$HOME/.antidote"
[[ ! -d "${ANTIDOTE_HOME}" ]] && mkdir -p ${ANTIDOTE_HOME}

# Set the root name of the plugins files (.txt and .zsh) antidote will use.
zsh_plugins=${ZDOTDIR:-~}/.zsh_plugins

# Ensure the .zsh_plugins.txt file exists so you can add plugins.
[[ -f ${zsh_plugins}.txt ]] || touch ${zsh_plugins}.txt

# Lazy-load antidote from its functions directory.
fpath=(${ANTIDOTE_SRC:-~/.local/share/antidote}/functions $fpath)
autoload -Uz antidote

# Generate a new static file whenever .zsh_plugins.txt is updated.
if [[ ! ${zsh_plugins}.zsh -nt ${zsh_plugins}.txt ]]; then
	antidote bundle <${zsh_plugins}.txt >|${zsh_plugins}.zsh
fi

# Source your static plugins file.
source ${zsh_plugins}.zsh

# Aliases
# -------

# Misc
alias cls='clear'
alias ..='cd ..'
alias cd..='cd ..'
alias cal='gcal --starting-day=1'

# Bat
alias cat='bat --color=always'
alias catn='command cat'
alias catnl='bat --paging=never'

# Eza
alias el="eza --icons=always --group-directories-first"
alias ell="eza -l --git --icons=always --group-directories-first"
alias elll="eza -la --sort=modified --reverse --git --icons=always --group-directories-first"
alias ela="eza -a --icons=always --group-directories-first"
alias ella="eza -la --git --icons=always --group-directories-first"
alias elsl="eza --color=always -la --git --icons=always --group-directories-first | less -R"
alias els="eza --icons=always --group-directories-first"
alias el1="eza -1 --icons=always --group-directories-first"
alias eldot="eza -A --icons=always --group-directories-first"
alias elsize="eza -l --sort=size --git --icons=always --group-directories-first"
alias eltime="eza -l --sort=modified --git --icons=always --group-directories-first"
alias elrecursive="eza -lR --git --icons=always --group-directories-first"
alias elt="eza --tree --level=2 --long --git --icons=always --group-directories-first"

# LSD
alias ll='lsd -lhg --group-dirs=first'
alias lll='lsd -ltrahg --group-dirs=first'
alias la='lsd -a --group-dirs=first'
alias l='lsd --group-dirs=first'
alias lla='lsd -lhag --group-dirs=first'
alias lsl="lsd --color=always -lhFAg --group-dirs=first | less -R"
alias ls='lsd --group-dirs=first'
alias l1='lsd -1 --group-dirs=first'
alias ldot='lsd -A --group-dirs=first'
alias lsize='lsd -lSg --group-dirs=first'
alias ltime='lsd -ltg --group-dirs=first'
alias lrecursive='lsd -lRg --group-dirs=first'
alias lt='lsd --tree --depth=2 --long --git --group-dirs=first'

# ZSH misc
# --------

# XDG setup (used by Lazygit)
export XDG_CONFIG_HOME="$HOME/.config"

# Export terminal size so child processes without a controlling tty
# (e.g. delta spawned by `chezmoi diff`) can still detect the real width.
export COLUMNS LINES

# Load colors first
autoload -Uz colors && colors

# Enable emacs mode for the keybindings
bindkey -e
bindkey "^[[3~" delete-char
bindkey  "^[[H" beginning-of-line
bindkey  "^[[F" end-of-line
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase # Remove duplicates from history
setopt appendhistory
setopt sharehistory # Share history across shell sessions
setopt hist_ignore_space # Prevents saving commands starting with a space
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Add additional figlet fonts
[[ $+commands[figlet] ]] && export FIGLET_FONTDIR="$HOME/.local/share/figlet/fonts"

# Default ls colors
[[ $+commands[dircolors] ]] && eval "$(dircolors)"

# Completion styling
zstyle ':plugin:ez-compinit' 'use-cache' 'yes'
zstyle ':plugin:ez-compinit' 'compstyle' 'zshzoo'
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:z:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:z:*' fzf-flags --preview-window=right:50%:wrap

# Starship
# --------
eval "$(starship init zsh)"

# Mise
# ----
zsh-defer eval "$(mise activate zsh)"

# Shell integrations
# ------------------
eval "$(fzf --zsh)"

# Zoxide
# ------
zsh-defer eval "$(zoxide init zsh)"

# Additional configs
# ------------------

# Load extra config
[ -f ~/.zshrc.extra ] && source ~/.zshrc.extra

# Load local config
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
